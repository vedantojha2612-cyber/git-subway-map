# ==========================================
# Git Subway Map - Git Ignore Rules
# ==========================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
eggs/
parts/
bin/
var/
sdist/
develop-eggs/
.installed.cfg
lib/
lib64/
*.manifest
*.spec

# Keep prebuilt frontend production bundle for zero-config CLI launcher
!frontend/dist/
!frontend/dist/**

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js & Frontend dependencies
node_modules/
.npm/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
frontend/.vite/

# Generated runtime and test repositories
demo-repo/
test-repo/
backend/git-subway-map/

# Environment and Secrets
.env
.env.*
!.env.example

# Operating System & Editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~
